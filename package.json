{
  "name": "vue-grab-scroll",
  "version": "1.1.0",
  "description": "Vue composable and directive that scroll a container when the user drags it with the mouse.",
  "homepage": "https://github.com/IlyaSemenov/vue-grab-scroll#readme",
  "bugs": "https://github.com/IlyaSemenov/vue-grab-scroll/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/vue-grab-scroll.git"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "release": "changesets-release",
    "test": "bun test",
    "types": "bun check && bun check -p tests"
  },
  "dependencies": {
    "@vueuse/core": "^14.0.0 || ^15.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@ilyasemenov/oxc-config": "^0.1.3",
    "@tsconfig/bun": "^1.0.12",
    "@types/bun": "^1.4.5",
    "changesets-release": "^2.3.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vue": "^3.5.46"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "packageManager": "bun@1.4.5"
}
